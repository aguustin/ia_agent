# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=obras_validator
DB_SSL=false

# JWT
JWT_ACCESS_SECRET=change_me_min_32_chars_random_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_min_32_chars_random_hex
JWT_REFRESH_EXPIRES_IN=7d

# Redis (required by BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Storage provider: "local" | "r2" | "s3"
STORAGE_PROVIDER=local

# Local storage (used when STORAGE_PROVIDER=local)
LOCAL_STORAGE_PATH=./uploads
LOCAL_STORAGE_BASE_URL=http://localhost:3000/storage/files

# Cloudflare R2 (used when STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://files.yourdomain.com
R2_SIGNED_URL_EXPIRES_IN=3600
R2_REQUEST_TIMEOUT_MS=30000

# OpenAI
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# BullMQ workers
ANALYSIS_QUEUE_CONCURRENCY=5
ANALYSIS_JOB_ATTEMPTS=3
ANALYSIS_JOB_BACKOFF_DELAY=5000
PRE_VALIDATION_CONCURRENCY=3
